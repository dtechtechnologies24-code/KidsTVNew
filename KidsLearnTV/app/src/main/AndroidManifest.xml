<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:allowBackup="true" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.KidsLearnTV" android:banner="@drawable/tv_banner" tools:targetApi="21">
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name" android:screenOrientation="landscape" android:theme="@style/Theme.KidsLearnTV.Fullscreen">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
